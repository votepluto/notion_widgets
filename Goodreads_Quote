body {
  background: #262421; /* dark study room */
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  padding: 40px;
  font-family: 'EB Garamond', serif;
}

/* outer wrapper */
.wax-wrapper {
  perspective: 1000px;
}

/* parchment letter */
.letter-card {
  background: #f3efe6;
  width: 420px;
  padding: 60px 50px 70px;
  border-radius: 4px;
  position: relative;

  box-shadow:
    0 30px 60px rgba(0,0,0,0.4),
    inset 0 0 40px rgba(0,0,0,0.08);
}

/* subtle paper texture */
.letter-card::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image: url("https://www.transparenttextures.com/patterns/old-paper.png");
  opacity: 0.35;
  pointer-events: none;
  border-radius: 4px;
}

.letter-title {
  font-family: 'Cormorant Garamond', serif;
  font-weight: 700;
  font-size: 32px;
  margin-bottom: 35px;
  letter-spacing: 0.5px;
}

.letter-title a {
  text-decoration: none;
  color: #4b2e2e;
}

#gr_quote_body {
  font-size: 17px;
  line-height: 1.9;
  color: #3a342d;
  position: relative;
}

/* oversized faded quote mark */
#gr_quote_body::before {
  content: "“";
  position: absolute;
  left: -25px;
  top: -25px;
  font-size: 90px;
  color: rgba(90, 60, 40, 0.08);
  font-family: 'Cormorant Garamond', serif;
}

.letter-footer {
  margin-top: 40px;
  font-size: 12px;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.letter-footer a {
  text-decoration: none;
  color: #7a6a58;
}

/* Wax Seal */
.wax-seal {
  position: absolute;
  bottom: -30px;
  right: 40px;

  width: 80px;
  height: 80px;
  background: radial-gradient(circle at 30% 30%, #8b1e2d, #5a0f1b 70%);
  border-radius: 50%;

  display: flex;
  align-items: center;
  justify-content: center;

  font-family: 'Cormorant Garamond', serif;
  font-size: 30px;
  color: #f3efe6;

  box-shadow:
    0 10px 20px rgba(0,0,0,0.4),
    inset 0 3px 8px rgba(255,255,255,0.2),
    inset 0 -6px 12px rgba(0,0,0,0.4);
}

/* subtle hover tilt */
.letter-card:hover {
  transform: rotateX(2deg) rotateY(-2deg);
  transition: 0.4s ease;
}
