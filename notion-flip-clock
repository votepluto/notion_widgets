<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Clock</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500&display=swap');

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html, body {
    background: transparent;
  }

  body {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100vh;
    font-family: 'Outfit', sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow: hidden;
  }

  .clock-container {
    display: flex;
    align-items: center;
    gap: clamp(16px, 4vw, 36px);
    animation: fadeIn 1s ease both;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .card-group {
    display: flex;
    gap: clamp(6px, 1.5vw, 14px);
  }

  .card {
    position: relative;
    width: clamp(56px, 14vw, 120px);
    height: clamp(72px, 18vw, 156px);
    perspective: 400px;
  }

  .card-face {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: clamp(8px, 2vw, 16px);
    background: #D9BBB8;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-shadow:
      0 1px 2px rgba(160,110,108,0.08),
      0 4px 14px rgba(160,110,108,0.1);
  }

  .card-face::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1.5px;
    background: rgba(0,0,0,0.05);
    z-index: 2;
  }

  .card-face::before {
    content: '';
    position: absolute;
    top: calc(50% - 4px);
    left: -1px;
    width: 6px;
    height: 9px;
    background: transparent;
    border-radius: 0 50% 50% 0;
    z-index: 3;
    box-shadow: calc(clamp(56px, 14vw, 120px) - 4px) 0 0 0 transparent;
  }

  .card-digit {
    font-size: clamp(2.2rem, 8vw, 5.4rem);
    font-weight: 500;
    color: #5C3D3B;
    letter-spacing: -0.02em;
    line-height: 1;
    z-index: 1;
    user-select: none;
  }

  .flip-top, .flip-bottom {
    position: absolute;
    left: 0;
    right: 0;
    height: 50%;
    overflow: hidden;
    backface-visibility: hidden;
  }

  .flip-top {
    top: 0;
    border-radius: clamp(8px, 2vw, 16px) clamp(8px, 2vw, 16px) 0 0;
    transform-origin: bottom center;
    z-index: 10;
    background: #D9BBB8;
  }

  .flip-bottom {
    bottom: 0;
    border-radius: 0 0 clamp(8px, 2vw, 16px) clamp(8px, 2vw, 16px);
    transform-origin: top center;
    z-index: 10;
    background: #D9BBB8;
  }

  .flip-top.animating {
    animation: flipDown 0.45s cubic-bezier(0.4, 0.0, 0.2, 1) forwards;
  }

  .flip-bottom.animating {
    animation: flipUp 0.45s cubic-bezier(0.4, 0.0, 0.2, 1) 0.22s forwards;
  }

  @keyframes flipDown {
    from { transform: rotateX(0deg); }
    to { transform: rotateX(-90deg); }
  }

  @keyframes flipUp {
    from { transform: rotateX(90deg); }
    to { transform: rotateX(0deg); }
  }

  .flip-top .flip-digit,
  .flip-bottom .flip-digit {
    position: absolute;
    width: 100%;
    text-align: center;
    font-size: clamp(2.2rem, 8vw, 5.4rem);
    font-weight: 500;
    color: #5C3D3B;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .flip-top .flip-digit {
    bottom: -50%;
    transform: translateY(-15%);
  }

  .flip-bottom .flip-digit {
    top: -50%;
    transform: translateY(15%);
  }

  .separator {
    display: flex;
    flex-direction: column;
    gap: clamp(10px, 2.5vw, 22px);
    padding-bottom: 4px;
  }

  .dot {
    width: clamp(6px, 1.5vw, 10px);
    height: clamp(6px, 1.5vw, 10px);
    border-radius: 50%;
    background: #D9BBB8;
    animation: dotPulse 2s ease-in-out infinite;
  }

  .dot:nth-child(2) {
    animation-delay: 0.15s;
  }

  @keyframes dotPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.3; transform: scale(0.85); }
  }
</style>
</head>
<body>

<div class="clock-container" id="clock">
  <div class="card-group">
    <div class="card" id="card-h1">
      <div class="card-face"><span class="card-digit" id="h1">0</span></div>
    </div>
    <div class="card" id="card-h2">
      <div class="card-face"><span class="card-digit" id="h2">0</span></div>
    </div>
  </div>

  <div class="separator">
    <div class="dot"></div>
    <div class="dot"></div>
  </div>

  <div class="card-group">
    <div class="card" id="card-m1">
      <div class="card-face"><span class="card-digit" id="m1">0</span></div>
    </div>
    <div class="card" id="card-m2">
      <div class="card-face"><span class="card-digit" id="m2">0</span></div>
    </div>
  </div>
</div>

<script>
  const digits = {
    h1: document.getElementById('h1'),
    h2: document.getElementById('h2'),
    m1: document.getElementById('m1'),
    m2: document.getElementById('m2'),
  };

  const cards = {
    h1: document.getElementById('card-h1'),
    h2: document.getElementById('card-h2'),
    m1: document.getElementById('card-m1'),
    m2: document.getElementById('card-m2'),
  };

  let prev = { h1: '', h2: '', m1: '', m2: '' };

  function pad(n) { return n.toString().padStart(2, '0'); }

  function flipCard(cardEl, oldVal, newVal, digitEl) {
    const face = cardEl.querySelector('.card-face');

    const flipTop = document.createElement('div');
    flipTop.className = 'flip-top animating';
    const topDigit = document.createElement('span');
    topDigit.className = 'flip-digit';
    topDigit.textContent = oldVal;
    flipTop.appendChild(topDigit);

    const flipBottom = document.createElement('div');
    flipBottom.className = 'flip-bottom animating';
    const bottomDigit = document.createElement('span');
    bottomDigit.className = 'flip-digit';
    bottomDigit.textContent = newVal;
    flipBottom.appendChild(bottomDigit);

    digitEl.textContent = newVal;

    face.appendChild(flipTop);
    face.appendChild(flipBottom);

    setTimeout(() => {
      flipTop.remove();
      flipBottom.remove();
    }, 800);
  }

  function tick() {
    const now = new Date();
    const h = pad(now.getHours());
    const m = pad(now.getMinutes());

    const current = { h1: h[0], h2: h[1], m1: m[0], m2: m[1] };

    for (const key in current) {
      if (current[key] !== prev[key] && prev[key] !== '') {
        flipCard(cards[key], prev[key], current[key], digits[key]);
      } else if (prev[key] === '') {
        digits[key].textContent = current[key];
      }
    }

    prev = { ...current };
  }

  tick();
  setInterval(tick, 1000);
</script>
</body>
</html>
