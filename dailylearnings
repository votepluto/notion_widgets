<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Daily Panel</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@500;700;800;900&display=swap" rel="stylesheet">

  <style>
    :root{
      --bgA: #fdf7fb;
      --bgB: #f6eef6;

      --ink: rgba(58, 40, 65, 0.88);
      --muted: rgba(58, 40, 65, 0.52);

      --rose: rgba(236, 200, 255, 0.35);
      --blush: rgba(255, 210, 240, 0.30);

      --card: rgba(255,255,255,0.35);
      --border: rgba(58, 40, 65, 0.09);
    }

    *{ box-sizing: border-box; }

    html, body{
      margin: 0;
      padding: 0;
      height: 100%;
      background: transparent;
      font-family: "DM Sans", system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      color: var(--ink);
    }

    /* full-width background band (fills Notion iframe whitespace) */
    .band{
      min-height: 100vh;
      padding: 12px;
      background:
        radial-gradient(140% 180% at 85% -20%, var(--rose) 0%, transparent 65%),
        radial-gradient(160% 200% at -20% 130%, var(--blush) 0%, transparent 70%),
        linear-gradient(180deg, var(--bgA) 0%, var(--bgB) 100%);
    }

    /* narrow sidebar container */
    .panel{
      width: 100%;
      max-width: 420px;
      margin: 0 auto;
      display: grid;
      gap: 10px;
    }

    .panelTitle{
      font-size: 14px;
      font-weight: 900;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--muted);
      padding: 4px 2px;
    }

    /* details/summary toggles */
    .section{
      border: 1px solid var(--border);
      background: var(--card);
      padding: 8px;
    }

    .summary{
      cursor: pointer;
      list-style: none;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      font-weight: 800;
      letter-spacing: -0.01em;
      padding: 6px 6px;
    }

    .summary::-webkit-details-marker{ display:none; }

    .summaryLeft{
      font-size: 14px;
    }

    .chev{
      color: var(--muted);
      font-weight: 900;
      transition: transform 180ms ease;
    }

    .section[open] .chev{
      transform: rotate(180deg);
    }

    /* widget cards inside toggles */
    .card{
      border-top: 1px solid rgba(58, 40, 65, 0.10);
      padding: 10px 6px 6px;
      margin-top: 6px;
    }

    .titleRow{
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 10px;
      margin-bottom: 6px;
    }

    .title{
      font-size: 13px;
      font-weight: 900;
      letter-spacing: -0.01em;
    }

    .hint{
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--muted);
    }

    /* make PNG widgets responsive in narrow columns */
    .widgetLink{ display: block; }

    .widgetImg{
      width: 100%;
      height: auto;
      display: block;
      max-width: 100%;
    }

    .credits{
      font-size: 11px;
      color: var(--muted);
      padding: 4px 2px;
    }

    .credits a{
      color: var(--muted);
      text-decoration: none;
      border-bottom: 1px solid rgba(58, 40, 65, 0.18);
    }

    .credits a:hover{
      color: var(--ink);
      border-bottom-color: rgba(58, 40, 65, 0.35);
    }
  </style>
</head>

<body>
  <div class="band">
    <div class="panel">

      <div class="panelTitle">Daily</div>

      <details class="section" open>
        <summary class="summary">
          <span class="summaryLeft">Words</span>
          <span class="chev">▾</span>
        </summary>

        <div class="card">
          <div class="titleRow">
            <div class="title">Word</div>
            <div class="hint">daily</div>
          </div>
          <a class="widgetLink" href="https://www.thefreedictionary.com/_/WoD/png-click.aspx?t=wod" target="_top" rel="noopener">
            <img class="widgetImg" src="https://www.thefreedictionary.com/_/!wod!350!0.png" alt="Word of the Day">
          </a>
        </div>

        <div class="card">
          <div class="titleRow">
            <div class="title">Quote</div>
            <div class="hint">daily</div>
          </div>
          <a class="widgetLink" href="https://www.thefreedictionary.com/_/WoD/png-click.aspx?t=quote" target="_top" rel="noopener">
            <img class="widgetImg" src="https://www.thefreedictionary.com/_/!quote!350!1.png" alt="Quote of the Day">
          </a>
        </div>
      </details>

      <details class="section">
        <summary class="summary">
          <span class="summaryLeft">Articles</span>
          <span class="chev">▾</span>
        </summary>

        <div class="card">
          <div class="titleRow">
            <div class="title">Article</div>
            <div class="hint">daily</div>
          </div>
          <a class="widgetLink" href="https://www.thefreedictionary.com/_/WoD/png-click.aspx?t=aod" target="_top" rel="noopener">
            <img class="widgetImg" src="https://www.thefreedictionary.com/_/!aod!350!3.png" alt="Article of the Day">
          </a>
        </div>

        <div class="card">
          <div class="titleRow">
            <div class="title">History</div>
            <div class="hint">daily</div>
          </div>
          <a class="widgetLink" href="https://www.thefreedictionary.com/_/WoD/png-click.aspx?t=history" target="_top" rel="noopener">
            <img class="widgetImg" src="https://www.thefreedictionary.com/_/!history!350!3.png" alt="This Day in History">
          </a>
        </div>
      </details>

      <details class="section">
        <summary class="summary">
          <span class="summaryLeft">This Day in History</span>
          <span class="chev">▾</span>
        </summary>

        <div class="card">
          <div class="titleRow">
            <div class="title">Birthday</div>
            <div class="hint">today</div>
          </div>
          <a class="widgetLink" href="https://www.thefreedictionary.com/_/WoD/png-click.aspx?t=birthday" target="_top" rel="noopener">
            <img class="widgetImg" src="https://www.thefreedictionary.com/_/!birthday!350!3.png" alt="Today's Birthday">
          </a>
        </div>

        <div class="card">
          <div class="titleRow">
            <div class="title">Holiday</div>
            <div class="hint">today</div>
          </div>
          <a class="widgetLink" href="https://www.thefreedictionary.com/_/WoD/png-click.aspx?t=holiday" target="_top" rel="noopener">
            <img class="widgetImg" src="https://www.thefreedictionary.com/_/!holiday!350!3.png" alt="Today's Holiday">
          </a>
        </div>
      </details>

      <div class="credits">
        Source:
        <a href="https://www.thefreedictionary.com/" target="_top" rel="nofollow noopener">TheFreeDictionary</a>
      </div>

    </div>
  </div>
</body>
</html>
